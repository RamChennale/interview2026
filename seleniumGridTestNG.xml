<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Regression Suite" verbose="1" parallel="tests" thread-count="5">
    <test name="Chrome on Windows">
        <parameter name="os" value="windows"/>
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.selenium.A1_seleniumInterviewEx.seleniumGrid.SeleniumGridLoginTest"/>
        </classes>
    </test>

    <test name="edge on Windows">
        <parameter name="os" value="windows"/>
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.selenium.A1_seleniumInterviewEx.seleniumGrid.SeleniumGridLoginTest"/>
        </classes>
    </test>

    <test name="firefox on Windows">
        <parameter name="os" value="windows"/>
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.selenium.A1_seleniumInterviewEx.seleniumGrid.SeleniumGridLoginTest"/>
        </classes>
    </test>

</suite>
