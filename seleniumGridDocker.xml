<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Regression Suite" verbose="1" parallel="tests" thread-count="5">
    <test name="Chrome on linux">
        <parameter name="os" value="Linux"/>
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.selenium.A1_seleniumInterviewEx.DockerSeleniumGrid.SeleniumDockerGridLoginTest"/>
        </classes>
    </test>

    <test name="firefox on Linux">
        <parameter name="os" value="Linux"/>
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.selenium.A1_seleniumInterviewEx.DockerSeleniumGrid.SeleniumDockerGridLoginTest"/>
        </classes>
    </test>

</suite>
